---
/**
 * Header, footer and <head> for every website page. The page fetches the brand
 * (`site`) and the visitor (`viewer`) with `pageContext` / `staticContext` and
 * passes them in, so the layout never makes an API call of its own.
 *
 * Log in, Join and the community itself are App pages on this same hostname:
 * always plain `<a href>`, never a client-side route.
 */
import '../styles/global.css';
import '../styles/site.css';

import Icon from '../components/Icon.astro';
import {BRAND, community, NAV, PHOTOS} from '../content/site';
import type {Site, Viewer} from '../lib/types';
import {initials} from '../lib/format';
import {siteOrigin} from '../platform/api';

interface Props {
  site: Site | null;
  viewer: Viewer;
  /** The page's own name; the tab shows "<title> · <community>". Omit on home. */
  title?: string;
  description?: string;
  /** Social card image (absolute URL). */
  image?: string | null;
  /**
   * A PRERENDERED page (`export const prerender = true`): built once, served
   * as a static file, so it knows no visitor. The header then renders the
   * signed-out view and the browser fills in the visitor (`/site-api/me`) and
   * a renamed community (`/site-api/site`) after load.
   */
  isStatic?: boolean;
}

const DEFAULT_DESCRIPTION = BRAND.description;
const DEFAULT_IMAGE = PHOTOS.success;

const {site, viewer, title, description = DEFAULT_DESCRIPTION, image = DEFAULT_IMAGE, isStatic = false} = Astro.props;
// The BEE brand is fixed in code (logo, name); the platform's name is only a fallback.
const name = BRAND.name || site?.name || 'Business Efficiency Experts';
const fullTitle = title ? `${title} · ${name}` : `${name} (${BRAND.short}) · ${BRAND.tagline}`;
const path = Astro.url.pathname;
const canonical = new URL(path, siteOrigin(Astro.url)).href;
const active = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
// Back to this page after signing in. A PATH only: the App ignores full URLs.
const back = encodeURIComponent(`${path}${Astro.url.search}`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={title ?? name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/brand/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body data-viewer={viewer.state} data-static={isStatic ? '1' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header-inner">
        <a href="/" class="brand" aria-label={`${name} home`}>
          <img class="brand-logo-img" src="/brand/bee-mark-96.png" alt="" width="40" height="40" />
          <span class="brand-text">
            <span class="brand-name">{BRAND.short}</span>
            <span class="brand-sub">{name}</span>
          </span>
        </a>
        <nav class="site-nav" aria-label="Main">
          {NAV.map(item => (
            <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
        <div class="header-actions">
        <div class="session" data-session>
          {viewer.state === 'member' ? (
            <>
              <a class="button ghost small-button" href={community('/feeds')}>
                Community
              </a>
              <span class="viewer" title={viewer.name ?? ''}>
                {viewer.avatar ? (
                  <img src={viewer.avatar} alt="" width="28" height="28" />
                ) : (
                  <span class="avatar-fallback" aria-hidden="true">
                    {initials(viewer.name ?? '')}
                  </span>
                )}
              </span>
              {viewer.preview ? (
                <span class="chip" title="Editor preview: a stand-in signed-in member">Preview</span>
              ) : (
                <button class="button link small-button" type="button" data-logout>
                  Sign out
                </button>
              )}
            </>
          ) : viewer.state === 'applicant' ? (
            <a class="button small-button" href={community('/join')}>
              Finish joining
            </a>
          ) : (
            <>
              <a class="button plain small-button" href={community(`/login?redirectTo=${back}`)}>
                Log in
              </a>
              <a class="button secondary small-button" href={community('/join')}>
                Join
              </a>
            </>
          )}
        </div>
        <a class="button header-cta" href={BRAND.callHref}>Book a call</a>
        </div>
        <a class="button small-button header-cta-compact" href={BRAND.callHref}>Book a call</a>
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" data-menu-button>
          <Icon name="menu" class="menu-open" />
          <Icon name="close" class="menu-close" />
        </button>
      </div>
      <div class="mobile-menu" id="mobile-menu" hidden data-mobile-menu>
        <nav aria-label="Main">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
          {NAV.map(item => (
            <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
        <div class="button-row">
          <a class="button lg" href={BRAND.callHref}>Book a discovery call</a>
          <a class="button lg secondary" href={BRAND.phoneHref}><Icon name="phone" />Call {BRAND.phone}</a>
        </div>
        <div class="button-row" data-guest-only hidden={viewer.state !== 'guest' && viewer.state !== 'returning'}>
          <a class="button secondary" href={community(`/login?redirectTo=${back}`)}>Log in</a>
          <a class="button secondary" href={community('/join')}>Join</a>
        </div>
        <div class="button-row" data-member-only hidden={viewer.state !== 'member'}>
          <a class="button secondary" href={community('/feeds')}>Open the community</a>
          <a class="button secondary" href="/portal">Dashboard</a>
        </div>
      </div>
    </header>

    <div id="main" tabindex="-1">
      <slot />
    </div>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-brand">
            <a href="/" class="brand">
              <img class="brand-logo-img" src="/brand/bee-mark-96.png" alt="" width="40" height="40" />
              <span class="brand-text">
                <span class="brand-name">{BRAND.short}</span>
                <span class="brand-sub">{name}</span>
              </span>
            </a>
            <p>{BRAND.footer}</p>
            <p><a class="text-link" href={BRAND.phoneHref}><Icon name="phone" />{BRAND.phone}</a></p>
          </div>
          <div class="footer-cols">
            <nav class="footer-col" aria-labelledby="f-programs">
              <h2 id="f-programs">Programs</h2>
              <a href="/coaching">Business coaching</a>
              <a href="/agency">Build your agency</a>
              <a href="/toolkit">The toolkit</a>
              <a href={BRAND.callHref}>Book a discovery call</a>
            </nav>
            <nav class="footer-col" aria-labelledby="f-company">
              <h2 id="f-company">Company</h2>
              <a href="/">Home</a>
              <a href="/about">About</a>
              <a href="/blog">Blog</a>
              <a href="/contact">Contact</a>
            </nav>
            <nav class="footer-col" aria-labelledby="f-community">
              <h2 id="f-community">Community</h2>
              <a href={community('/join')}>Join BEE</a>
              <a href={community(`/login?redirectTo=${back}`)}>Log in</a>
              <a href={community('/feeds')}>Community feed</a>
            </nav>
          </div>
        </div>
        <div class="footer-base">
          <span>© {new Date().getUTCFullYear()} {name}</span>
          <span>{BRAND.tagline}</span>
        </div>
      </div>
    </footer>

    <!--
      Join: every Join button opens this first, with the BEE CRM form, so the
      lead lands in the CRM. The account itself is still created on the
      community's own /join page (never here). Without JavaScript, Join is a
      plain link to /join.
    -->
    <dialog class="join-dialog" aria-labelledby="join-title" data-join-dialog data-form-url={BRAND.joinFormUrl}>
      <div class="join-head">
        <img src="/brand/bee-mark-96.png" alt="" width="40" height="40" />
        <div>
          <h2 class="t-card" id="join-title">Join {name}</h2>
          <p class="form-note">Tell us a little about your business. Then create your free account.</p>
        </div>
        <button class="join-close" type="button" aria-label="Close" data-join-close><Icon name="close" /></button>
      </div>
      <div class="join-body">
        <div class="crm-form" data-join-form></div>
        <div class="join-done" data-join-done hidden tabindex="-1">
          <Icon name="check" />
          <h3>Thanks, we’ve got your details</h3>
          <p>One last step: create your free account to get into the community.</p>
          <a class="button lg" href={community('/join')}>Create your free account <Icon name="arrow" /></a>
        </div>
      </div>
      <p class="join-skip" data-join-skip>
        Already been in touch? <a href={community('/join')}>Create your account</a>
      </p>
    </dialog>

    <script>
      import {logout, refreshSession} from '../platform/browser';
      import {hydrateStaticPage} from '../platform/static-page';

      import {COMMUNITY_URL} from '../content/site';

      /** The platform's header script draws short links (/join, /feeds…): send them to the community. */
      const toCommunity = () => {
        for (const a of document.querySelectorAll<HTMLAnchorElement>('a[href^="/"]')) {
          const path = a.getAttribute('href') ?? '';
          if (/^\/(join|feeds|login|register)(?=$|[/?#])/.test(path)) a.href = new URL(path, COMMUNITY_URL).href;
        }
      };

      if (document.body.dataset.static === '1') void hydrateStaticPage().then(toCommunity, toCommunity);

      // ---- Join: the BEE CRM form first, then the community's /join ---------
      const joinDialog = document.querySelector<HTMLDialogElement>('[data-join-dialog]');
      const joinUrl = new URL('/join', COMMUNITY_URL).href;
      const FORM_SCRIPT = 'https://crm.beegr8.com/embed/smart-form.js?v=3';

      const loadJoinForm = (dialog: HTMLDialogElement) => {
        const slot = dialog.querySelector<HTMLElement>('[data-join-form]');
        if (!slot || slot.childElementCount) return;
        const form = document.createElement('div');
        form.setAttribute('data-usezu-form', dialog.dataset.formUrl ?? '');
        form.setAttribute('data-header', '0');
        form.setAttribute('data-bg', 'transparent');
        form.setAttribute('data-min-height', '480');
        form.setAttribute('data-title', 'Join form');
        slot.append(form);
        const loader = window as unknown as {UsezuForms?: {init: () => void}};
        if (loader.UsezuForms) loader.UsezuForms.init();
        else if (!document.querySelector(`script[src="${FORM_SCRIPT}"]`)) {
          const script = document.createElement('script');
          script.src = FORM_SCRIPT;
          script.async = true;
          document.head.append(script);
        }
      };

      if (joinDialog && typeof joinDialog.showModal === 'function') {
        document.addEventListener('click', event => {
          const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
          if (!link || link.closest('[data-join-dialog]')) return;
          // Applicants have already applied: their "Finish joining" goes straight on.
          if (link.href !== joinUrl || document.body.dataset.viewer === 'applicant') return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
          event.preventDefault();
          loadJoinForm(joinDialog);
          joinDialog.showModal();
        });
        joinDialog.querySelector('[data-join-close]')?.addEventListener('click', () => joinDialog.close());
        // A click on the dimmed backdrop (the dialog itself, outside its content) closes it.
        joinDialog.addEventListener('click', event => {
          if (event.target === joinDialog) joinDialog.close();
        });
        joinDialog.addEventListener('usezu-form:submitted', () => {
          joinDialog.querySelector<HTMLElement>('[data-join-form]')!.hidden = true;
          joinDialog.querySelector<HTMLElement>('[data-join-skip]')!.hidden = true;
          const done = joinDialog.querySelector<HTMLElement>('[data-join-done]')!;
          done.hidden = false;
          done.focus();
        });
      }

      // Phone menu: a disclosure button, closes on Escape and on a link tap.
      const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
      const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
      if (menuButton && menu) {
        const setOpen = (open: boolean) => {
          menu.hidden = !open;
          menuButton.setAttribute('aria-expanded', String(open));
          menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        };
        menuButton.addEventListener('click', () => setOpen(menu.hidden));
        menu.addEventListener('click', event => {
          if ((event.target as HTMLElement).closest('a')) setOpen(false);
        });
        document.addEventListener('keydown', event => {
          if (event.key === 'Escape' && !menu.hidden) {
            setOpen(false);
            menuButton.focus();
          }
        });
      }

      // The server saw an expired access token but a refresh cookie: refresh
      // ONCE in the browser (the server never does), then re-render signed in.
      if (document.body.dataset.viewer === 'returning') {
        const key = 'site:refreshed';
        let first = true;
        try {
          first = !sessionStorage.getItem(key);
          sessionStorage.setItem(key, '1');
        } catch {
          // Storage blocked: no way to remember the reload, so never reload
          // (it would repeat on every load). The visitor signs in again.
          first = false;
        }
        if (first) void refreshSession().then(ok => ok && window.location.reload());
      } else {
        try {
          sessionStorage.removeItem('site:refreshed');
        } catch {
          // Storage blocked: nothing to clear.
        }
      }

      // Every button shows when it is busy (AGENTS.md "Buttons and forms").
      const busy = (button: HTMLButtonElement, label?: string) => {
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        if (label) button.textContent = label;
      };

      document.querySelectorAll<HTMLButtonElement>('[data-logout]').forEach(button =>
        button.addEventListener('click', () => {
          busy(button, 'Signing out…');
          void logout();
        })
      );

      // A search / filter form (GET) navigates: show its button busy until the next page.
      document.addEventListener('submit', event => {
        const form = event.target;
        if (event.defaultPrevented || !(form instanceof HTMLFormElement)) return;
        if (form.method.toLowerCase() !== 'get') return;
        if (event.submitter instanceof HTMLButtonElement) busy(event.submitter);
      });
      // Back/forward restores a page from memory: give its buttons back.
      window.addEventListener('pageshow', event => {
        if (!event.persisted) return;
        document.querySelectorAll<HTMLButtonElement>('button[aria-busy="true"]').forEach(button => {
          button.disabled = false;
          button.removeAttribute('aria-busy');
        });
      });
    </script>
  </body>
</html>
