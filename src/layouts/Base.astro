---
/**
 * Header, footer and <head> for every website page. The page fetches the brand
 * (`site`) and the visitor (`viewer`) with `pageContext` / `staticContext` and
 * passes them in, so the layout never makes an API call of its own.
 *
 * Log in, Join and the community itself are App pages on this same hostname:
 * always plain `<a href>`, never a client-side route.
 */
import '../styles/global.css';
import '../styles/site.css';

import BrandMark from '../components/BrandMark.astro';
import Icon from '../components/Icon.astro';
import {NAV, UPCOMING} from '../content/site';
import type {Site, Viewer} from '../lib/types';
import {initials} from '../lib/format';
import {siteOrigin} from '../platform/api';

interface Props {
  site: Site | null;
  viewer: Viewer;
  /** The page's own name; the tab shows "<title> · <community>". Omit on home. */
  title?: string;
  description?: string;
  /** Social card image (absolute URL). */
  image?: string | null;
  /**
   * A PRERENDERED page (`export const prerender = true`): built once, served
   * as a static file, so it knows no visitor. The header then renders the
   * signed-out view and the browser fills in the visitor (`/site-api/me`) and
   * a renamed community (`/site-api/site`) after load.
   */
  isStatic?: boolean;
}

const DEFAULT_DESCRIPTION =
  'Breakfasts, workshops and info nights for Missouri’s local service businesses, hosted by Saving America Money.';
const DEFAULT_IMAGE = 'https://images.unsplash.com/photo-1591115765373-5207764f72e7?auto=format&fit=crop&w=1200&q=70';

const {site, viewer, title, description = DEFAULT_DESCRIPTION, image = DEFAULT_IMAGE, isStatic = false} = Astro.props;
const name = site?.name ?? 'Saving America Money';
const fullTitle = title ? `${title} · ${name}` : `${name} · Events for local pros`;
const path = Astro.url.pathname;
const canonical = new URL(path, siteOrigin(Astro.url)).href;
const active = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
// Back to this page after signing in. A PATH only: the App ignores full URLs.
const back = encodeURIComponent(`${path}${Astro.url.search}`);
const ticketHref = UPCOMING.length ? '/#tickets' : '/schedule';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={title ?? name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    {site?.favIcon && <link rel="icon" href={site.favIcon} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body data-viewer={viewer.state} data-static={isStatic ? '1' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header-inner">
        <a href="/" class="brand" aria-label={`${name} home`}>
          {site?.logo && <BrandMark site={site} size={34} />}
          <span class="brand-name" data-brand-text="{name}" data-built-name={name}>{name}</span><span class="brand-dot" aria-hidden="true"></span>
        </a>
        <nav class="site-nav" aria-label="Main">
          {NAV.map(item => (
            <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
        <div class="header-actions">
        <div class="session" data-session>
          {viewer.state === 'member' ? (
            <>
              <a class="button ghost small-button" href="/feeds">
                Community
              </a>
              <span class="viewer" title={viewer.name ?? ''}>
                {viewer.avatar ? (
                  <img src={viewer.avatar} alt="" width="28" height="28" />
                ) : (
                  <span class="avatar-fallback" aria-hidden="true">
                    {initials(viewer.name ?? '')}
                  </span>
                )}
              </span>
              {viewer.preview ? (
                <span class="chip" title="Editor preview: a stand-in signed-in member">Preview</span>
              ) : (
                <button class="button link small-button" type="button" data-logout>
                  Sign out
                </button>
              )}
            </>
          ) : viewer.state === 'applicant' ? (
            <a class="button small-button" href="/join">
              Finish joining
            </a>
          ) : (
            <>
              <a class="button plain small-button" href={`/login?redirectTo=${back}`}>
                Log in
              </a>
              <a class="button secondary small-button" href="/join">
                Join
              </a>
            </>
          )}
        </div>
        <a class="button header-cta" href={ticketHref}>Get tickets</a>
        </div>
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" data-menu-button>
          <Icon name="menu" class="menu-open" />
          <Icon name="close" class="menu-close" />
        </button>
      </div>
      <div class="mobile-menu" id="mobile-menu" hidden data-mobile-menu>
        <nav aria-label="Main">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
          {NAV.map(item => (
            <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
        <div class="button-row">
          <a class="button lg" href={ticketHref}>Get tickets</a>
        </div>
        <div class="button-row" data-guest-only hidden={viewer.state !== 'guest' && viewer.state !== 'returning'}>
          <a class="button secondary" href={`/login?redirectTo=${back}`}>Log in</a>
          <a class="button secondary" href="/join">Join</a>
        </div>
        <div class="button-row" data-member-only hidden={viewer.state !== 'member'}>
          <a class="button secondary" href="/feeds">Open the community</a>
          <a class="button secondary" href="/portal">Dashboard</a>
        </div>
      </div>
    </header>

    <div id="main" tabindex="-1">
      <slot />
    </div>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-brand">
            <a href="/" class="brand">
              <span class="brand-name" data-brand-text="{name}">{name}</span><span class="brand-dot" aria-hidden="true"></span>
            </a>
            <p>Morning meetups for the local pros who keep Missouri running, from the team behind the premium 9×12 co-op postcard.</p>
          </div>
          <div class="footer-cols">
            <nav class="footer-col" aria-labelledby="f-events">
              <h2 id="f-events">Events</h2>
              <a href="/schedule">Upcoming events</a>
              <a href="/schedule#past">Past events</a>
              <a href={ticketHref}>Get tickets</a>
              <a href="/speakers">Speakers</a>
              <a href="/gallery">Gallery</a>
            </nav>
            <nav class="footer-col" aria-labelledby="f-company">
              <h2 id="f-company">Company</h2>
              <a href="/">Home</a>
              <a href="/about">About</a>
              <a href="/sponsors">Sponsors</a>
              <a href="/blog">Blog</a>
              <a href="/contact">Contact</a>
            </nav>
            <nav class="footer-col" aria-labelledby="f-community">
              <h2 id="f-community">Community</h2>
              <a href="/join">Join</a>
              <a href={`/login?redirectTo=${back}`}>Log in</a>
              <a href="/feeds">Community feed</a>
            </nav>
          </div>
        </div>
        <div class="footer-base">
          <span data-brand-text="© {year} {name}">© {new Date().getUTCFullYear()} {name}</span>
          <span>Made in Missouri for local pros.</span>
        </div>
      </div>
    </footer>

    <script>
      import {logout, refreshSession} from '../platform/browser';
      import {hydrateStaticPage} from '../platform/static-page';

      if (document.body.dataset.static === '1') void hydrateStaticPage();

      // Phone menu: a disclosure button, closes on Escape and on a link tap.
      const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
      const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
      if (menuButton && menu) {
        const setOpen = (open: boolean) => {
          menu.hidden = !open;
          menuButton.setAttribute('aria-expanded', String(open));
          menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        };
        menuButton.addEventListener('click', () => setOpen(menu.hidden));
        menu.addEventListener('click', event => {
          if ((event.target as HTMLElement).closest('a')) setOpen(false);
        });
        document.addEventListener('keydown', event => {
          if (event.key === 'Escape' && !menu.hidden) {
            setOpen(false);
            menuButton.focus();
          }
        });
      }

      // The server saw an expired access token but a refresh cookie: refresh
      // ONCE in the browser (the server never does), then re-render signed in.
      if (document.body.dataset.viewer === 'returning') {
        const key = 'site:refreshed';
        let first = true;
        try {
          first = !sessionStorage.getItem(key);
          sessionStorage.setItem(key, '1');
        } catch {
          // Storage blocked: no way to remember the reload, so never reload
          // (it would repeat on every load). The visitor signs in again.
          first = false;
        }
        if (first) void refreshSession().then(ok => ok && window.location.reload());
      } else {
        try {
          sessionStorage.removeItem('site:refreshed');
        } catch {
          // Storage blocked: nothing to clear.
        }
      }

      // Every button shows when it is busy (AGENTS.md "Buttons and forms").
      const busy = (button: HTMLButtonElement, label?: string) => {
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        if (label) button.textContent = label;
      };

      document.querySelectorAll<HTMLButtonElement>('[data-logout]').forEach(button =>
        button.addEventListener('click', () => {
          busy(button, 'Signing out…');
          void logout();
        })
      );

      // A search / filter form (GET) navigates: show its button busy until the next page.
      document.addEventListener('submit', event => {
        const form = event.target;
        if (event.defaultPrevented || !(form instanceof HTMLFormElement)) return;
        if (form.method.toLowerCase() !== 'get') return;
        if (event.submitter instanceof HTMLButtonElement) busy(event.submitter);
      });
      // Back/forward restores a page from memory: give its buttons back.
      window.addEventListener('pageshow', event => {
        if (!event.persisted) return;
        document.querySelectorAll<HTMLButtonElement>('button[aria-busy="true"]').forEach(button => {
          button.disabled = false;
          button.removeAttribute('aria-busy');
        });
      });
    </script>
  </body>
</html>
