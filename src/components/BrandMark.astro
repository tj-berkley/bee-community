---
/**
 * The BEE mark (`public/brand/`): the bee with the growth arrow. The brand is
 * fixed in code, so it shows even before the community uploads a logo.
 */
import type {Site} from '../lib/types';
import {BRAND} from '../content/site';

interface Props {
  site?: Site | null;
  size?: number;
}

const {size = 32} = Astro.props;
const src = size > 48 ? '/brand/bee-logo.png' : '/brand/bee-mark-96.png';
---

<img class="brand-logo" src={src} alt={BRAND.name} width={size} height={size} style={`height: ${size}px; width: ${size}px`} />
