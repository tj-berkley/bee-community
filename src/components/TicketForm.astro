---
/**
 * "Get your ticket": reserve seats at an upcoming event. Saved to the Site
 * Database (`POST /site-api/inbox/tickets`); payment is at the door, so no
 * card details are ever asked for. Preselects `?event=<slug>` from the URL.
 */
import {eventDate, UPCOMING} from '../content/site';
import Field from './Field.astro';
import Icon from './Icon.astro';

interface Props {
  /** Preselected event slug (defaults to the next event). */
  event?: string;
  heading?: string;
}

const {event = UPCOMING[0]?.slug ?? '', heading = 'Get your ticket'} = Astro.props;
const options = UPCOMING.map(e => ({value: e.slug, label: `${e.title} · ${eventDate(e, {weekday: undefined})} · ${e.price}`}));
---

<div class="form-panel" id="tickets">
  <h2 class="t-card">{heading}</h2>
  <p class="form-note">Reserve now, pay at the door. We confirm every seat by email within one business day.</p>

  {
    UPCOMING.length === 0 ? (
      <p>New dates are on the way. <a href="/contact">Ask to be told first</a>.</p>
    ) : (
      <form class="site-form" novalidate data-site-form data-endpoint="/site-api/inbox/tickets" data-done="ticket-done">
        <Field id="t-event" name="event" label="Event" rule="event" type="select" options={options} value={event} full />
        <Field id="t-name" name="name" label="Your name" rule="name" autocomplete="name" placeholder="Jordan Lee" />
        <Field id="t-business" name="business" label="Business name" rule="business" autocomplete="organization" placeholder="Lee Plumbing & Drain" />
        <Field id="t-trade" name="trade" label="Your trade" rule="trade" placeholder="Plumbing" hint="So we seat you with non-competing pros." />
        <Field
          id="t-seats"
          name="seats"
          label="Seats"
          rule="seats"
          type="select"
          value="1"
          options={[1, 2, 3, 4].map(n => ({value: String(n), label: n === 1 ? '1 seat' : `${n} seats`}))}
        />
        <Field id="t-email" name="email" label="Email" rule="email" type="email" inputmode="email" autocomplete="email" placeholder="name@example.com" />
        <Field id="t-phone" name="phone" label="Phone" rule="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="314-555-0100" optional />
        <div class="form-hp" aria-hidden="true">
          <label for="t-website">Leave this empty</label>
          <input id="t-website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <div class="form-actions full">
          <button class="button lg" type="submit" data-pending-label="Reserving…">
            <Icon name="ticket" />
            Reserve my seat
          </button>
          <p class="form-note">No payment now. Cancel any time by replying to your confirmation.</p>
        </div>
        <p class="form-alert error full" data-form-alert role="alert" hidden></p>
      </form>
    )
  }

  <div class="form-done" id="ticket-done" tabindex="-1" hidden>
    <Icon name="check" />
    <h3>You’re on the list</h3>
    <p>Thanks! We’ll email you to confirm your seat and send directions a few days before the event.</p>
    <a class="button secondary" href="/schedule">See all events</a>
  </div>
</div>

<script>
  import {initSiteForms} from '../lib/form-client';

  // `/schedule?event=<slug>#tickets` picks that event.
  const wanted = new URLSearchParams(window.location.search).get('event');
  const select = document.querySelector<HTMLSelectElement>('#t-event');
  if (wanted && select && Array.from(select.options).some(o => o.value === wanted)) select.value = wanted;

  initSiteForms();
</script>
