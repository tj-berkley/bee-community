---
/** Speakers: who talks at our events, and where to hear them next. PRERENDERED. */
import Icon from '../components/Icon.astro';
import {eventDate, SPEAKERS, UPCOMING} from '../content/site';
import Base from '../layouts/Base.astro';
import {staticContext} from '../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
const nextFor = (slug: string) => UPCOMING.find(e => e.speakers.includes(slug));
---

<Base
  site={site}
  viewer={viewer}
  isStatic
  title="Speakers"
  description="Meet the owners, Realtors and route leads who speak at Saving America Money breakfasts and workshops.">
  <main>
    <header class="wrap page-hero">
      <div class="stack">
        <p class="kicker">Speakers</p>
        <h1 class="t-page">Owners talking to owners</h1>
        <p class="t-lead">
          No marketing gurus. Our speakers run local businesses, anchor real routes and bring their own tracked numbers.
        </p>
      </div>
    </header>

    <section class="wrap" style="padding-block-end: 112px" aria-label="Speakers">
      <div class="speaker-grid">
        {
          SPEAKERS.map(s => {
            const next = nextFor(s.slug);
            return (
              <article class="speaker" id={s.slug}>
                <img src={s.photo} alt={`Portrait of ${s.name}`} loading="lazy" width="600" height="600" />
                <h2 class="t-card">{s.name}</h2>
                <p class="role">{s.role}</p>
                <p>{s.bio}</p>
                <p class="talk">
                  <strong style="color: var(--ink)">Talk:</strong> {s.talk}
                  {next && (
                    <>
                      <br />
                      <strong style="color: var(--ink)">Next:</strong>{' '}
                      <a href={`/schedule#${next.slug}`}>
                        {next.title}, {eventDate(next, {weekday: undefined, year: undefined})}
                      </a>
                    </>
                  )}
                </p>
              </article>
            );
          })
        }
      </div>
    </section>

    <section class="dark-band section secondary">
      <div class="wrap cta-split">
        <div class="stack">
          <p class="kicker">Speak at an event</p>
          <h2 class="t-heading">Have numbers worth sharing?</h2>
          <p class="t-lead">
            We look for local owners with a real story: a campaign that worked, one that flopped, and what you learned.
          </p>
        </div>
        <div class="button-row">
          <a class="button lg on-dark" href="/contact?topic=speaking">Pitch a talk <Icon name="arrow" /></a>
          <a class="button lg outline-dark" href="/schedule">See events</a>
        </div>
      </div>
    </section>
  </main>
</Base>
