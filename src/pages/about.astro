---
/** About: who runs the events, and the card behind them. PRERENDERED. */
import Icon from '../components/Icon.astro';
import {ABOUT, PHOTOS} from '../content/site';
import Base from '../layouts/Base.astro';
import {staticContext} from '../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
---

<Base site={site} viewer={viewer} isStatic title="About" description={ABOUT.lede}>
  <main>
    <section class="section" style="padding-block-start: 96px">
      <div class="wrap hero-split">
        <div class="stack">
          <p class="kicker">About</p>
          <h1 class="t-page">{ABOUT.title}</h1>
          <p class="t-lead">{ABOUT.lede}</p>
          <div class="button-row">
            <a class="button lg" href="/schedule">See upcoming events</a>
            <a class="button lg secondary" href="/contact">Talk to us</a>
          </div>
        </div>
        <div class="hero-media">
          <div class="frame">
            <img src={PHOTOS.meeting} alt="Business owners with notebooks talking around a meeting table" width="1400" height="1050" />
          </div>
        </div>
      </div>
    </section>

    <section class="band section secondary">
      <div class="wrap narrow story">
        {
          ABOUT.story.map(part => (
            <div>
              <h2>{part.heading}</h2>
              <p>{part.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section secondary" aria-labelledby="card-title">
      <div class="wrap">
        <div class="section-head">
          <div class="stack">
            <p class="kicker">The 9×12 card</p>
            <h2 class="t-heading" id="card-title">{ABOUT.card.title}</h2>
          </div>
          <p class="t-lead">
            Spots are $900, $1,300 and $1,800 per 10,000 homes, with design, printing and mailing included.
          </p>
        </div>
        <div class="stat-strip">
          {
            ABOUT.card.items.map(item => (
              <div>
                <span class="figure">{item.value}</span>
                <span class="figure-label">{item.label}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="band section secondary">
      <div class="wrap">
        <div class="section-head">
          <div class="stack">
            <p class="kicker">What we stand for</p>
            <h2 class="t-heading">Premium reach at a shared cost</h2>
          </div>
        </div>
        <div class="rule-grid">
          {
            ABOUT.values.map(value => (
              <div>
                <h3>{value.title}</h3>
                <p>{value.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="dark-band section secondary">
      <div class="wrap cta-split">
        <div class="stack">
          <p class="kicker">Build your own territory</p>
          <h2 class="t-heading">Run a local marketing business</h2>
          <p class="t-lead">
            Our licensing program equips entrepreneurs to sell the card and directory listings in their own area. Start at
            a free info night.
          </p>
        </div>
        <div class="button-row">
          <a class="button lg on-dark" href="/schedule#licensee-info-night-online">Licensee info night <Icon name="arrow" /></a>
          <a class="button lg outline-dark" href="/contact?topic=licensing">Ask a question</a>
        </div>
      </div>
    </section>
  </main>
</Base>
