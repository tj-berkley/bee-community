---
/** About: why BEE exists and what it stands for. PRERENDERED. */
import CtaBand from '../components/CtaBand.astro';
import {ABOUT, BRAND, PHOTOS} from '../content/site';
import Base from '../layouts/Base.astro';
import {staticContext} from '../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
---

<Base site={site} viewer={viewer} isStatic title="About" description={ABOUT.lede} image={PHOTOS.boardroom}>
  <main>
    <section class="section" style="padding-block-start: 96px">
      <div class="wrap hero-split">
        <div class="stack">
          <p class="kicker">About BEE</p>
          <h1 class="t-page">{ABOUT.title}</h1>
          <p class="t-lead">{ABOUT.lede}</p>
          <div class="button-row">
            <a class="button lg" href="/coaching">See the coaching</a>
            <a class="button lg secondary" href={BRAND.callHref}>Talk to us</a>
          </div>
        </div>
        <div class="hero-media">
          <div class="frame">
            <img src={PHOTOS.boardroom} alt="A team meeting around a table with laptops in a bright room" width="1400" height="934" fetchpriority="high" />
          </div>
        </div>
      </div>
    </section>

    <section class="band section secondary">
      <div class="wrap narrow story">
        {
          ABOUT.story.map(part => (
            <div>
              <h2>{part.heading}</h2>
              <p>{part.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section secondary">
      <div class="wrap">
        <div class="section-head">
          <div class="stack">
            <p class="kicker">What we stand for</p>
            <h2 class="t-heading">How the hive works</h2>
          </div>
        </div>
        <div class="rule-grid">
          {
            ABOUT.values.map((value, i) => (
              <div>
                <span class="rule-num">0{i + 1}</span>
                <h3>{value.title}</h3>
                <p>{value.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="band section secondary">
      <div class="wrap hero-split">
        <div class="hero-media">
          <div class="frame">
            <img src={PHOTOS.community} alt="Four people smiling around a table, looking at a phone together" width="1400" height="934" loading="lazy" />
          </div>
        </div>
        <div class="stack">
          <p class="kicker">The community</p>
          <h2 class="t-heading-md">Owners helping owners</h2>
          <p class="t-lead">
            Inside BEE you’ll find coaching calls, step-by-step playbooks and members sharing the setups, templates and
            numbers that work for them. On the web and in the app.
          </p>
          <a class="button lg secondary" href="/join" data-guest-only>Join the community</a>
          <a class="button lg secondary" href="/feeds" data-member-only hidden>Open the community</a>
        </div>
      </div>
    </section>

    <CtaBand />
  </main>
</Base>
