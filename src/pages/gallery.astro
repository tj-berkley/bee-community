---
/** Gallery: photos from our events. PRERENDERED; photos in `src/content/site.ts`. */
import {GALLERY} from '../content/site';
import Base from '../layouts/Base.astro';
import {staticContext} from '../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
---

<Base
  site={site}
  viewer={viewer}
  isStatic
  title="Gallery"
  description="Photos from Saving America Money breakfasts, workshops and licensee info nights across Missouri.">
  <main>
    <header class="wrap page-hero">
      <div class="stack">
        <p class="kicker">Gallery</p>
        <h1 class="t-page">Early mornings, full rooms</h1>
        <p class="t-lead">Coffee at 7:30, real numbers by 8, handshakes by 9. A look inside our events.</p>
      </div>
    </header>

    <section class="wrap" style="padding-block-end: 112px" aria-label="Event photos">
      <div class="gallery">
        {
          GALLERY.map((photo, i) => (
            <figure class:list={{wide: photo.wide}}>
              <img src={photo.src} alt={photo.alt} loading={i < 3 ? 'eager' : 'lazy'} width="1400" height="1050" />
              <figcaption>{photo.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="dark-band section secondary">
      <div class="wrap cta-split">
        <div class="stack">
          <p class="kicker">Be in the next one</p>
          <h2 class="t-heading">Grab a seat at the table</h2>
          <p class="t-lead">The next breakfast is coming up soon. Reserve now, pay at the door.</p>
        </div>
        <div class="button-row">
          <a class="button lg on-dark" href="/#tickets">Get your ticket</a>
          <a class="button lg outline-dark" href="/schedule">See all events</a>
        </div>
      </div>
    </section>
  </main>
</Base>
