---
/** Business coaching: what it covers and how it runs. PRERENDERED. */
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import {BRAND, COACHING, PHOTOS} from '../content/site';
import Base from '../layouts/Base.astro';
import {staticContext} from '../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
---

<Base site={site} viewer={viewer} isStatic title="Business coaching" description={COACHING.lede} image={PHOTOS.workshop}>
  <main>
    <section class="section" style="padding-block-start: 96px">
      <div class="wrap hero-split">
        <div class="stack">
          <p class="kicker">Business coaching</p>
          <h1 class="t-page">{COACHING.title}</h1>
          <p class="t-lead">{COACHING.lede}</p>
          <div class="button-row">
            <a class="button lg" href={BRAND.callHref}>Book a strategy call</a>
            <a class="button lg secondary" href="/join" data-guest-only>Join BEE</a>
          </div>
        </div>
        <div class="hero-media">
          <div class="frame">
            <img src={PHOTOS.workshop} alt="A woman leading a team session at a whiteboard covered in sticky notes" width="1400" height="934" fetchpriority="high" />
          </div>
        </div>
      </div>
    </section>

    <section class="band section secondary">
      <div class="wrap">
        <div class="section-head">
          <div class="stack">
            <p class="kicker">The focus</p>
            <h2 class="t-heading">{COACHING.focus.title}</h2>
          </div>
        </div>
        <div class="rule-grid">
          {
            COACHING.focus.items.map((item, i) => (
              <div>
                <span class="rule-num">0{i + 1}</span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section secondary">
      <div class="wrap">
        <div class="section-head">
          <div class="stack">
            <p class="kicker">The format</p>
            <h2 class="t-heading">{COACHING.format.title}</h2>
          </div>
          <a class="text-link" href="/toolkit">See the toolkit <Icon name="arrow" /></a>
        </div>
        <div class="rule-grid">
          {
            COACHING.format.items.map(item => (
              <div>
                <span class="icon-tile">
                  <Icon name={item.icon} />
                </span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <Faq items={COACHING.faq} />

    <CtaBand title="Get your time back" body="Start with a strategy call: we find the biggest time drain in your business and the fastest way to fix it." />
  </main>
</Base>
