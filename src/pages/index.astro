---
/**
 * Home: the BEE landing page. PRERENDERED (built once, served as a file).
 * Words in `src/content/site.ts`.
 *
 * Filled in by the browser after load:
 *   - the visitor (`<Base isStatic>`): members see "Open the community", guests "Join BEE";
 *   - the latest blog posts (`data-live`, from the community API via the Site API).
 */
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import ToolCard from '../components/ToolCard.astro';
import {BRAND, FACTS, HOME, PHOTOS, TOOLS} from '../content/site';
import Base from '../layouts/Base.astro';
import {staticContext} from '../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
const {hero, pillars, steps, paths, faq, cta} = HOME;
---

<Base site={site} viewer={viewer} isStatic>
  <main>
    <!-- Hero -->
    <section class="section hero-top">
      <div class="wrap hero-split">
        <div class="stack">
          <p class="kicker">{hero.eyebrow}</p>
          <h1 class="t-hero">{hero.title}</h1>
          <p class="t-lead">{hero.body}</p>
          <div class="button-row">
            <a class="button lg" href="/join" data-guest-only>Join BEE <Icon name="arrow" /></a>
            <a class="button lg" href="/feeds" data-member-only hidden>Open the community <Icon name="arrow" /></a>
            <a class="button lg secondary" href={BRAND.callHref}>Book a discovery call</a>
          </div>
        </div>
        <div class="hero-media">
          <div class="frame">
            <img src={PHOTOS.success} alt="Two colleagues high-fiving across a desk with a laptop" width="1400" height="934" fetchpriority="high" />
          </div>
          <div class="hero-card">
            <img src="/brand/bee-mark-96.png" alt="" width="52" height="52" />
            <div>
              <strong>Coaching · Community · Tools</strong>
              <span>Everything you need to run leaner, in one hive</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Facts from the toolkit -->
    <section class="wrap facts" aria-label="The toolkit in numbers">
      <div class="stat-strip">
        {
          FACTS.map(fact => (
            <div>
              <span class="figure">{fact.value}</span>
              <span class="figure-label">{fact.label}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Why -->
    <section class="band section secondary">
      <div class="wrap">
        <div class="section-head">
          <div class="stack">
            <p class="kicker">Why now</p>
            <h2 class="t-heading">{pillars.title}</h2>
          </div>
          <p class="t-lead">{pillars.lead}</p>
        </div>
        <div class="rule-grid">
          {
            pillars.items.map(item => (
              <div>
                <span class="icon-tile">
                  <Icon name={item.icon} />
                </span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- The toolkit -->
    <section class="section secondary" id="toolkit" style="scroll-margin-top: 80px">
      <div class="wrap">
        <div class="section-head">
          <div class="stack">
            <p class="kicker">The toolkit</p>
            <h2 class="t-heading">Four platforms. One growth system.</h2>
          </div>
          <a class="text-link" href="/toolkit">How they work together <Icon name="arrow" /></a>
        </div>
        <div class="tool-grid">{TOOLS.map(tool => <ToolCard tool={tool} />)}</div>
      </div>
    </section>

    <!-- How it works -->
    <section class="band section secondary">
      <div class="wrap">
        <div class="section-head">
          <div class="stack">
            <p class="kicker">Three steps</p>
            <h2 class="t-heading">{steps.title}</h2>
          </div>
        </div>
        <div class="rule-grid">
          {
            steps.items.map((item, i) => (
              <div>
                <span class="rule-num">0{i + 1}</span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Two paths -->
    <section class="section secondary" aria-labelledby="paths-title">
      <div class="wrap">
        <div class="section-head">
          <div class="stack">
            <p class="kicker">Who it’s for</p>
            <h2 class="t-heading" id="paths-title">{paths.title}</h2>
          </div>
          <p class="t-lead">{paths.lead}</p>
        </div>
        <div class="tier-grid">
          {
            paths.items.map(path => (
              <article class:list={['tier', {featured: path.featured}]}>
                <div class="button-row" style="justify-content: space-between; align-items: center">
                  <h3>{path.name}</h3>
                  {path.featured && <span class="badge spark">Most popular</span>}
                </div>
                <p class="per" style="margin: 0">{path.who}</p>
                <ul>
                  {path.items.map(item => (
                    <li>
                      <Icon name="check" />
                      {item}
                    </li>
                  ))}
                </ul>
                <a class:list={['button lg', path.featured ? 'on-dark' : 'secondary']} href={path.cta.href}>
                  {path.cta.label}
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Latest blog posts (community API), hidden when there are none -->
    <section class="band section secondary" data-live="posts" hidden>
      <div class="wrap">
        <div class="section-head">
          <div class="stack">
            <p class="kicker">Blog</p>
            <h2 class="t-heading">Fresh from the hive</h2>
          </div>
          <a class="text-link" href="/blog">All posts <Icon name="arrow" /></a>
        </div>
        <div class="card-grid" data-list></div>
      </div>
    </section>

    <Faq items={faq} />

    <CtaBand eyebrow={cta.eyebrow} title={cta.title} body={cta.body} />
  </main>
</Base>

<script>
  import {formatDate} from '../lib/format';
  import type {PostsPage} from '../lib/types';

  /** One element with text: never HTML from an answer. */
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = '') => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  };

  async function loadPosts() {
    const section = document.querySelector<HTMLElement>('[data-live="posts"]');
    const list = section?.querySelector<HTMLElement>('[data-list]');
    if (!section || !list) return;
    try {
      const res = await fetch('/site-api/posts?perPage=3', {headers: {accept: 'application/json'}});
      if (!res.ok) return;
      const data = (await res.json()) as PostsPage;
      for (const post of data.posts) {
        const card = el('a', 'ecard');
        card.href = `/blog/${encodeURIComponent(post.slug)}`;
        const media = el('div', 'ecard-media');
        if (post.coverUrl) {
          const img = el('img');
          img.src = post.coverUrl;
          img.alt = '';
          img.loading = 'lazy';
          media.append(img);
        }
        card.append(media);
        const body = el('div', 'ecard-body');
        body.append(el('h3', 't-card', post.title));
        if (post.excerpt) body.append(el('p', '', post.excerpt.slice(0, 120)));
        body.append(el('p', 'form-note', formatDate(post.publishedAt)));
        card.append(body);
        list.append(card);
      }
      if (data.posts.length > 0) section.hidden = false;
    } catch {
      // The section stays hidden: the page is complete without it.
    }
  }
  void loadPosts();
</script>
