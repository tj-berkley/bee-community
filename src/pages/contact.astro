---
/**
 * Contact: BEE's own Join BEE form (on the BEE CRM, so every request lands
 * there as a contact), the phone number, contact details and an FAQ.
 * PRERENDERED.
 */
import Icon from '../components/Icon.astro';
import {BRAND, CONTACT} from '../content/site';
import Base from '../layouts/Base.astro';
import {staticContext} from '../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
---

<Base site={site} viewer={viewer} isStatic title="Contact" description={CONTACT.lede}>
  <main>
    <header class="wrap page-hero">
      <div class="stack">
        <p class="kicker">Contact</p>
        <h1 class="t-page">{CONTACT.title}</h1>
        <p class="t-lead">{CONTACT.lede}</p>
      </div>
    </header>

    <section class="wrap two-col contact-body">
      <div class="stack" style="gap: 32px">
        <dl class="detail-list" style="width: 100%">
          {
            CONTACT.details.map(d => (
              <div>
                <dt>{d.label}</dt>
                <dd>{d.href ? <a href={d.href}>{d.value}</a> : d.value}</dd>
              </div>
            ))
          }
        </dl>
        <div class="stack" style="gap: 12px">
          <h2 class="t-card">Prefer to talk now?</h2>
          <p class="mt-0">Give us a call. If we miss you, leave a message and we’ll call you back.</p>
          <a class="button secondary" href={BRAND.phoneHref}><Icon name="phone" />Call {BRAND.phone}</a>
        </div>
      </div>

      <div class="form-panel" id="form">
        <h2 class="t-card">Book your discovery call</h2>
        <p class="form-note">Tell us about your business and we’ll be in touch within one business day.</p>
        <div class="crm-form">
          <div data-usezu-form={CONTACT.formUrl} data-header="0" data-bg="transparent" data-min-height="480"></div>
          <noscript>
            <p>
              The form needs JavaScript. You can <a href={CONTACT.formUrl}>open it on its own page</a> or call us on
              <a href={BRAND.phoneHref}>{BRAND.phone}</a>.
            </p>
          </noscript>
        </div>
      </div>
    </section>

    <section class="band section secondary" aria-labelledby="faq-title">
      <div class="wrap narrow">
        <h2 class="t-heading-md" id="faq-title" style="margin-bottom: 32px">Common questions</h2>
        <div class="faq">
          {
            CONTACT.faq.map(item => (
              <details>
                <summary>
                  {item.q}
                  <Icon name="plus" />
                </summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Base>

<!-- The BEE CRM's Smart Form loader: it fills [data-usezu-form] in place. -->
<script is:inline async src="https://crm.beegr8.com/embed/smart-form.js?v=3"></script>
