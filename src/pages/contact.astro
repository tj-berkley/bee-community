---
/**
 * Contact: a message form saved to the Site Database
 * (`POST /site-api/inbox/contact`), contact details and an FAQ. PRERENDERED;
 * `?topic=<topic>` preselects the subject in the browser.
 */
import Field from '../components/Field.astro';
import Icon from '../components/Icon.astro';
import {CONTACT} from '../content/site';
import {CONTACT_TOPICS, TOPIC_LABELS} from '../lib/forms';
import Base from '../layouts/Base.astro';
import {staticContext} from '../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
const topics = CONTACT_TOPICS.map(value => ({value, label: TOPIC_LABELS[value]}));
---

<Base site={site} viewer={viewer} isStatic title="Contact" description={CONTACT.lede}>
  <main>
    <header class="wrap page-hero">
      <div class="stack">
        <p class="kicker">Contact</p>
        <h1 class="t-page">{CONTACT.title}</h1>
        <p class="t-lead">{CONTACT.lede}</p>
      </div>
    </header>

    <section class="wrap two-col" style="padding-block-end: 112px">
      <div class="stack" style="gap: 32px">
        <dl class="detail-list" style="width: 100%">
          {
            CONTACT.details.map(d => (
              <div>
                <dt>{d.label}</dt>
                <dd>{d.href ? <a href={d.href}>{d.value}</a> : d.value}</dd>
              </div>
            ))
          }
        </dl>
        <div class="stack" style="gap: 12px">
          <h2 class="t-card">Want to talk it through?</h2>
          <p class="mt-0">
            Choose “Booking a strategy call” in the form and tell us about your business. We’ll reply with times that
            work.
          </p>
          <a class="button secondary" href="/toolkit"><Icon name="layers" />See the toolkit first</a>
        </div>
      </div>

      <div class="form-panel">
        <h2 class="t-card">Send a message</h2>
        <p class="form-note">We reply within one business day.</p>
        <form class="site-form" novalidate data-site-form data-endpoint="/site-api/inbox/contact" data-done="contact-done">
          <Field id="c-topic" name="topic" label="What’s it about?" rule="topic" type="select" options={topics} value="general" full />
          <Field id="c-name" name="name" label="Your name" rule="name" autocomplete="name" placeholder="Jordan Lee" />
          <Field id="c-business" name="business" label="Business" rule="businessOptional" autocomplete="organization" placeholder="Lee Consulting" optional />
          <Field id="c-email" name="email" label="Email" rule="email" type="email" inputmode="email" autocomplete="email" placeholder="name@example.com" full />
          <Field
            id="c-message"
            name="message"
            label="Message"
            rule="message"
            type="textarea"
            placeholder="Tell us what your business does and where you’d like to save time."
            hint="10 to 4,000 characters."
            full
          />
          <div class="form-hp" aria-hidden="true">
            <label for="c-website">Leave this empty</label>
            <input id="c-website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <div class="form-actions full">
            <button class="button lg" type="submit" data-pending-label="Sending…">
              <Icon name="mail" />
              Send message
            </button>
          </div>
          <p class="form-alert error full" data-form-alert role="alert" hidden></p>
        </form>
        <div class="form-done" id="contact-done" tabindex="-1" hidden>
          <Icon name="check" />
          <h3>Message sent</h3>
          <p>Thanks for reaching out. A real person will reply within one business day.</p>
          <a class="button secondary" href="/toolkit">Explore the toolkit</a>
        </div>
      </div>
    </section>

    <section class="band section secondary" aria-labelledby="faq-title">
      <div class="wrap narrow">
        <h2 class="t-heading-md" id="faq-title" style="margin-bottom: 32px">Common questions</h2>
        <div class="faq">
          {
            CONTACT.faq.map(item => (
              <details>
                <summary>
                  {item.q}
                  <Icon name="plus" />
                </summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import {initSiteForms} from '../lib/form-client';

  // `/contact?topic=strategy` picks the subject.
  const topic = new URLSearchParams(window.location.search).get('topic');
  const select = document.querySelector<HTMLSelectElement>('#c-topic');
  if (topic && select && Array.from(select.options).some(o => o.value === topic)) select.value = topic;

  initSiteForms();
</script>
