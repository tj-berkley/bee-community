---
/**
 * Events: upcoming and past. PRERENDERED; the events live in
 * `src/content/site.ts`. The page is at `/schedule` because `/events` belongs
 * to the community app (a Shadowed Path).
 */
import Icon from '../components/Icon.astro';
import TicketForm from '../components/TicketForm.astro';
import {eventDate, PAST, speakerBySlug, UPCOMING, type EventItem} from '../content/site';
import Base from '../layouts/Base.astro';
import {staticContext} from '../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);

const part = (event: EventItem, opts: Intl.DateTimeFormatOptions) =>
  new Date(event.start).toLocaleDateString('en-US', {timeZone: 'America/Chicago', ...opts});
const speakersOf = (event: EventItem) => event.speakers.map(speakerBySlug).filter(s => s !== undefined);
const totalAttendees = PAST.reduce((sum, e) => sum + (e.attendees ?? 0), 0);
---

<Base
  site={site}
  viewer={viewer}
  isStatic
  title="Events"
  description="Upcoming breakfasts, workshops and info nights for Missouri’s local service businesses, plus highlights from past events.">
  <main>
    <header class="wrap page-hero">
      <div class="stack">
        <p class="kicker">Events</p>
        <h1 class="t-page">Breakfasts, workshops and info nights</h1>
        <p class="t-lead">
          Ninety minutes of straight talk about local marketing, with the owners who keep Missouri running. Reserve a seat
          and pay at the door.
        </p>
        <div class="button-row">
          <a class="button lg" href="#tickets"><Icon name="ticket" />Get your ticket</a>
          <a class="button lg secondary" href="#past">Past events</a>
        </div>
      </div>
    </header>

    <section class="wrap" aria-labelledby="upcoming-title" style="padding-block-end: 96px">
      <h2 class="t-heading-md" id="upcoming-title" style="margin-bottom: 32px">Upcoming</h2>
      {UPCOMING.length === 0 && <p>New dates are on the way. <a href="/contact">Ask to hear first</a>.</p>}
      <ol class="event-list">
        {
          UPCOMING.map(event => (
            <li class="event-row" id={event.slug}>
              <div class="event-date">
                <span class="month">{part(event, {month: 'short'})}</span>
                <span class="day">{part(event, {day: 'numeric'})}</span>
                <span class="weekday">{part(event, {weekday: 'long'})}</span>
              </div>
              <div class="event-main">
                <div class="button-row" style="gap: 8px">
                  <span class="badge dot">{event.kind}</span>
                  <span class="badge neutral">{event.city}</span>
                </div>
                <h3 class="t-card" style="font-size: clamp(24px, 2.6vw, 30px); letter-spacing: -0.035em">{event.title}</h3>
                <p>{event.summary}</p>
                <div class="meta-line">
                  <span><Icon name="calendar" />{eventDate(event)}</span>
                  <span><Icon name="clock" />{event.time}</span>
                  <span><Icon name="pin" />{event.venue}</span>
                </div>
                <p class="form-note"><strong>For:</strong> {event.audience}</p>
                {event.agenda && (
                  <ol class="agenda">
                    {event.agenda.map(item => (
                      <li>
                        <time>{item.time}</time>
                        <span>{item.title}</span>
                      </li>
                    ))}
                  </ol>
                )}
                <div class="speaker-chips">
                  {speakersOf(event).map(s => (
                    <a class="speaker-chip" href={`/speakers#${s.slug}`}>
                      <img src={s.photo} alt="" width="26" height="26" loading="lazy" />
                      {s.name}
                    </a>
                  ))}
                </div>
              </div>
              <div class="event-side">
                <div class="frame">
                  <img src={event.photo} alt="" loading="lazy" width="800" height="600" />
                </div>
                <div>
                  <span class="price">{event.price}</span>
                  <p class="form-note" style="margin-top: 4px">{event.priceNote}</p>
                </div>
                <a class="button" href={`?event=${event.slug}#tickets`}>
                  <Icon name="ticket" />
                  Get your ticket
                </a>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    {
      UPCOMING.length > 0 && (
        <section class="band section secondary" aria-label="Reserve a seat">
          <div class="wrap two-col">
            <div class="stack">
              <p class="kicker">Tickets</p>
              <h2 class="t-heading-md">Save your seat</h2>
              <p>
                Seats are limited so every table has room to talk, and we keep it to one business per trade at each table.
                Reserve now and pay at the door. Info nights are free.
              </p>
              <p>
                Questions first? <a href="/contact">Send us a note</a>.
              </p>
            </div>
            <TicketForm />
          </div>
        </section>
      )
    }

    <section class="section secondary" id="past" aria-labelledby="past-title" style="scroll-margin-top: 70px">
      <div class="wrap">
        <div class="section-head">
          <div class="stack">
            <p class="kicker">Past events</p>
            <h2 class="t-heading-md" id="past-title">{totalAttendees} owners so far, and counting</h2>
          </div>
          <a class="text-link" href="/gallery">Photos from past events <Icon name="arrow" /></a>
        </div>
        <ul class="past-list">
          {
            PAST.map(event => (
              <li class="ecard">
                <div class="ecard-media">
                  <img src={event.photo} alt="" loading="lazy" width="800" height="500" />
                </div>
                <div class="ecard-body">
                  <div class="button-row" style="gap: 8px">
                    <span class="badge grey">{eventDate(event)}</span>
                    {event.attendees && <span class="badge">{event.attendees} attended</span>}
                  </div>
                  <h3 class="t-card">{event.title}</h3>
                  <p class="form-note">{event.city}</p>
                  <p>{event.summary}</p>
                  {event.highlight && (
                    <p style="color: var(--ink); font-weight: 600">{event.highlight}</p>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="dark-band section secondary">
      <div class="wrap cta-split">
        <div class="stack">
          <p class="kicker">Host one with us</p>
          <h2 class="t-heading">Want a breakfast in your town?</h2>
          <p class="t-lead">We are opening routes across Missouri. Tell us where, and we will bring the coffee.</p>
        </div>
        <div class="button-row">
          <a class="button lg on-dark" href="/contact">Suggest a city</a>
          <a class="button lg outline-dark" href="/sponsors">Sponsor an event</a>
        </div>
      </div>
    </section>
  </main>
</Base>
